# ==============================================================================
# Dreeve Running Chatbot Configuration
# ==============================================================================

# Data Source Mode: "dreeve" or "strava"
DATA_SOURCE=dreeve

# --- Option A: Dreeve SQLite Database ---
# For Docker: /data/database/dreeve.db
# For Local Python: ../dreeve/storage/database/dreeve.db (or your custom path)
DREEVE_DB_PATH=/data/database/dreeve.db
DREEVE_OUTPUT_DIR=./output

# --- Option B: Strava API v3 Live Ingestion (Path 2) ---
# Create an application at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REFRESH_TOKEN=your_strava_refresh_token

# General Settings
TZ=Asia/Kolkata
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
